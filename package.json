{
  "name": "vscode-workspace-tasks",
  "displayName": "Workspace Tasks",
  "description": "A Task Explorer for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "keywords": [
    "tasks",
    "task",
    "npm",
    "grunt",
    "gulp",
    "yarn",
    "ant",
    "makefile",
    "composer",
    "php",
    "multi-root ready",
    "c c++",
    "gradle",
    "tsc",
    "nsis",
    "batch",
    "bash"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ignore",
        "extensions": [
          ".tasksignore"
        ],
        "filenamePatterns": [
          ".tasksignore"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspace-tasks",
          "title": "Workspace Tasks",
          "icon": "res/icon.svg"
        }
      ]
    },
    "views": {
      "workspace-tasks": [
        {
          "id": "workspaceTasksView",
          "name": "Tasks",
          "icon": "res/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "workspaceTasks.refresh",
        "title": "Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "workspaceTasks.runTask",
        "title": "Run Task",
        "icon": "$(play)"
      },
      {
        "command": "workspaceTasks.stopTask",
        "title": "Stop Task",
        "icon": "$(stop)"
      },
      {
        "command": "workspaceTasks.addToFavorites",
        "title": "Add to Favorites",
        "icon": "$(star)"
      },
      {
        "command": "workspaceTasks.removeFromFavorites",
        "title": "Remove from Favorites",
        "icon": "$(star-full)"
      },
      {
        "command": "workspaceTasks.addToQueue",
        "title": "Add to Queue",
        "icon": "$(list-unordered)"
      },
      {
        "command": "workspaceTasks.runQueue",
        "title": "Run Queue",
        "icon": "$(play)"
      },
      {
        "command": "workspaceTasks.clearQueue",
        "title": "Clear Queue",
        "icon": "$(clear-all)"
      },
      {
        "command": "workspaceTasks.removeFromQueue",
        "title": "Remove from Queue",
        "icon": "$(trash)"
      },
      {
        "command": "workspaceTasks.renameQueue",
        "title": "Rename Queue",
        "icon": "$(edit)"
      },
      {
        "command": "workspaceTasks.context.addToQueue",
        "title": "Add to Queue"
      },
      {
        "command": "workspaceTasks.context.addToFavorites",
        "title": "Add to Favorites"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Workspace Tasks",
      "properties": {
        "workspaceTasks.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns to exclude from tasks.",
          "markdownDescription": "Glob patterns to exclude from tasks. For example, to ignore all tasks in `sample` folders, add `**/sample/**`."
        },
        "workspaceTasks.groups.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Group tasks by type, folder, and custom separator."
        },
        "workspaceTasks.groups.taskSeparator": {
          "type": "string",
          "default": "-",
          "description": "Separator used to split task name into groups.",
          "markdownDescription": "Separator used to split task name into groups. For example, a task named `build-frontend` with a separator of `-` would be grouped under `build`."
        },
        "workspaceTasks.enabledTaskTypes": {
          "type": "object",
          "additionalProperties": false,
          "description": "%config.workspaceTasks.enabledTaskTypes%",
          "properties": {
            "ant": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableAnt%"
            },
            "appPublisher": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableAppPublisher%"
            },
            "shell": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableShell%"
            },
            "composer": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableComposer%"
            },
            "docker": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableDocker%"
            },
            "gradle": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableGradle%"
            },
            "grunt": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableGrunt%"
            },
            "gulp": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableGulp%"
            },
            "make": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableMake%"
            },
            "maven": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableMaven%"
            },
            "npm": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableNpm%"
            },
            "nsis": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableNsis%"
            },
            "perl": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enablePerl%"
            },
            "pipenv": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enablePipenv%"
            },
            "pwsh": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enablePwsh%"
            },
            "python": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enablePython%"
            },
            "ruby": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableRuby%"
            },
            "tsc": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableTsc%"
            },
            "yarn": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableYarn%"
            },
            "venv": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableVenv%"
            },
            "vscode": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableVsCode%"
            },
            "workspace": {
              "type": "boolean",
              "description": "%config.workspaceTasks.enableWorkspace%"
            }
          },
          "default": {
            "ant": true,
            "appPublisher": true,
            "shell": true,
            "composer": true,
            "docker": true,
            "gradle": true,
            "grunt": true,
            "gulp": true,
            "make": true,
            "maven": true,
            "npm": true,
            "nsis": false,
            "perl": false,
            "pipenv": true,
            "pwsh": true,
            "python": true,
            "ruby": false,
            "tsc": true,
            "yarn": true,
            "venv": true,
            "vscode": true,
            "workspace": true
          }
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "workspaceTasks.refresh",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "workspaceTasks.runQueue",
          "when": "viewItem == queue",
          "group": "inline"
        },
        {
          "command": "workspaceTasks.renameQueue",
          "when": "viewItem == queue",
          "group": "inline"
        },
        {
          "command": "workspaceTasks.clearQueue",
          "when": "viewItem == queue",
          "group": "inline"
        },
        {
          "command": "workspaceTasks.runTask",
          "when": "viewItem == task || viewItem == favoriteTask || viewItem == queuedTask",
          "group": "inline@3"
        },
        {
          "command": "workspaceTasks.stopTask",
          "when": "viewItem == runningTask",
          "group": "inline@3"
        },
        {
          "command": "workspaceTasks.addToFavorites",
          "when": "viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "workspaceTasks.removeFromFavorites",
          "when": "viewItem == favoriteTask",
          "group": "inline@1"
        },
        {
          "command": "workspaceTasks.addToQueue",
          "when": "viewItem == task || viewItem == favoriteTask",
          "group": "inline@2"
        },
        {
          "command": "workspaceTasks.removeFromQueue",
          "when": "viewItem == queuedTask",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.9.3",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "ignore": "^7.0.5"
  }
}
