          "when": "view == workspaceTasksView || view == workspaceTasksExplorer"
        },
        {
          "command": "workspaceTasks.refresh",
          "group": "navigation@5",
          "when": "view == workspaceTasksView || view == workspaceTasksExplorer"
        },
        {
          "command": "workspaceTasks.openSettings",
          "group": "navigation@99",
          "when": "view == workspaceTasksView || view == workspaceTasksExplorer"
        },
        {
          "command": "workspaceTasks.showHiddenTasks",
          "group": "z_filter@6",
          "when": "(view == workspaceTasksView || view == workspaceTasksExplorer) && !workspaceTasks.showHiddenMode"
        },
        {
          "command": "workspaceTasks.hideHiddenTasks",
          "group": "z_filter@6",
          "when": "(view == workspaceTasksView || view == workspaceTasksExplorer) && workspaceTasks.showHiddenMode"
        },
        {
          "command": "workspaceTasks.resetFilteredTasks",
          "group": "z_filter_reset@7",
          "when": "view == workspaceTasksView || view == workspaceTasksExplorer"
        }
      ],
      "workspaceTasks.history.filter": [
        {
          "command": "workspaceTasks.history.enableFilterRunning",
          "group": "1_status",
          "when": "!workspaceTasks.history.showRunning"
        },
        {
          "command": "workspaceTasks.history.disableFilterRunning",
          "group": "1_status",
          "when": "workspaceTasks.history.showRunning"
        },
        {
          "command": "workspaceTasks.history.enableFilterSuccess",
          "group": "1_status",
          "when": "!workspaceTasks.history.showSuccess"
        },
        {
          "command": "workspaceTasks.history.disableFilterSuccess",
          "group": "1_status",
          "when": "workspaceTasks.history.showSuccess"
        },
        {
          "command": "workspaceTasks.history.enableFilterFailed",
          "group": "1_status",
          "when": "!workspaceTasks.history.showFailed"
        },
        {
          "command": "workspaceTasks.history.disableFilterFailed",
          "group": "1_status",
          "when": "workspaceTasks.history.showFailed"
        },
