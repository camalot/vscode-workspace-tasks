    "menus": {
      "view/title": [
        {
          "command": "workspaceTasks.history.clear",
          "group": "navigation@1",
          "when": "view == workspaceTasksHistoryView || view == workspaceTasksHistoryTableView"
        },
        {
          "command": "workspaceTasks.history.switchTableView",
          "group": "navigation@2",
          "when": "view == workspaceTasksHistoryView && workspaceTasks.history.viewMode == 'tree'"
        },
        {
          "command": "workspaceTasks.history.switchTreeView",
          "group": "navigation@2",
          "when": "view == workspaceTasksHistoryView && workspaceTasks.history.viewMode == 'table'"
        },
        {
          "submenu": "workspaceTasks.history.filter",
          "group": "navigation@3",
          "when": "view == workspaceTasksHistoryView || view == workspaceTasksHistoryTableView"
        },
        {
          "command": "workspaceTasks.history.switchTreeView",
          "group": "navigation@2",
          "when": "view == workspaceTasksHistoryTableView"
        },
        {
          "command": "workspaceTasks.githubIssues",
          "group": "navigation@1",
          "when": "view == workspaceTasksView || view == workspaceTasksExplorer"
