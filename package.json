{
  "name": "workspace-tasks",
  "displayName": "Workspace Tasks",
  "description": "A Task Explorer for Visual Studio Code",
  "readme": "README.md",
  "version": "1.1.11",
  "engines": {
    "vscode": "^1.105.1"
  },
  "author": {
    "name": "darthminos",
    "email": "camalot@gmail.com"
  },
  "homepage": "https://github.com/camalot/vscode-workspace-tasks",
  "repository": {
    "type": "git",
    "url": "https://github.com/camalot/vscode-workspace-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/camalot/vscode-workspace-tasks/issues",
    "new": "https://github.com/camalot/vscode-workspace-tasks/issues/new/choose"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/camalot",
    "github": "https://github.com/sponsors/camalot",
    "buymeacoffee": "https://www.buymeacoffee.com/darthminos"
  },
  "urls": {
    "vscmarketplace": "https://marketplace.visualstudio.com/items?itemName=darthminos.workspace-tasks",
    "openvsx": "https://open-vsx.org/extension/darthminos/workspace-tasks",
    "changelog": "https://github.com/camalot/vscode-workspace-tasks/blob/develop/CHANGELOG.md"
  },
  "license": "Apache-2.0",
  "publisher": "darthminos",
  "icon": "res/icon.png",
  "galleryBanner": {
    "color": "#333333",
    "theme": "dark"
  },
  "keywords": [
    "tasks",
    "task",
    "deno",
    "npm",
    "grunt",
    "gulp",
    "just",
    "maven",
    "msbuild",
    "vscode",
    "yarn",
    "pnpm",
    "venv",
    "docker",
    "github actions",
    "ant",
    "makefile",
    "composer",
    "php",
    "multi-root ready",
    "gradle",
    "tsc",
    "batch",
    "bash",
    "bun",
    "pipenv",
    "make"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "scripts": {
    "pretest": "npm run compile:tests && npm run compile:webpack && npm run lint",
    "lint": "eslint src",
    "compile": "npm run compile:webpack",
    "compile:webpack": "webpack",
    "compile:prod": "npm run check:types && npm run lint && npm run compile:webpack",
    "compile:tests": "tsc -p . --outDir out",
    "watch": "npm run watch:webpack",
    "watch:tsc": "tsc --noEmit --watch",
    "watch:tests": "tsc -p . -w --outDir out",
    "watch:webpack": "webpack --watch",
    "vscode:prepublish": "npm run compile:prod && npm run package:webpack",
    "vscode:test": "vscode-test",
    "vscode:test:coverage": "vscode-test --coverage && nyc report --reporter=text-lcov > coverage.lcov && codecov",
    "package": "npm run package:vsix",
    "package:prerelease": "npm run package:webpack && npm run package:vsix:prerelease",
    "package:webpack": "webpack --mode production --devtool hidden-source-map",
    "package:vsix": "npx @vscode/vsce package",
    "package:vsix:prerelease": "npx @vscode/vsce package --pre-release",
    "test": "npm run pretest && npm run vscode:test",
    "test:coverage": "npm run pretest && npm run vscode:test:coverage",
    "test:ui": "npm run compile:tests && node .vscode-uitest.mjs",
    "format": "prettier --write .",
    "check": "npm run check:types && npm run check:format",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check .",
    "changelog:build": "npx git-cliff --bump --output CHANGELOG.md"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.105.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.2",
    "git-cliff": "^2.12.0",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.4",
    "ignore": "^7.0.5",
    "smol-toml": "^1.6.0",
    "yaml": "^2.8.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "tasksignore",
        "aliases": [
          "Tasks Ignore"
        ],
        "extensions": [
          ".tasksignore"
        ],
        "filenamePatterns": [
          ".tasksignore"
        ],
        "icon": {
          "light": "res/icons/light/wst.svg",
          "dark": "res/icons/dark/wst.svg"
        },
        "configuration": "./res/syntaxes/tasksignore-language-configuration.json"
      },
      {
        "id": "workspace-tasks",
        "aliases": [
          "Workspace Tasks"
        ],
        "filenamePatterns": [
          "**/.workspace-tasks.json",
          "**/workspace-tasks.json"
        ],
        "icon": {
          "light": "res/icons/light/wst.svg",
          "dark": "res/icons/dark/wst.svg"
        },
        "mimetypes": [
          "application/json",
          "text/json"
        ],
        "configuration": "./res/syntaxes/workspace-tasks-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tasksignore",
        "scopeName": "ignore.tasksignore",
        "path": "./res/syntaxes/tasksignore.tmLanguage.json"
      },
      {
        "language": "workspace-tasks",
        "scopeName": "source.workspace-tasks",
        "path": "./res/syntaxes/workspace-tasks.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".workspace-tasks.json",
        "url": "./res/schemas/workspace-tasks.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspace-tasks",
          "title": "Workspace Tasks",
          "icon": "res/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "workspaceTasksHistory",
          "title": "Task History",
          "icon": "res/icon.svg"
        }
      ]
    },
    "views": {
      "workspaceTasksHistory": [
        {
          "id": "workspaceTasksHistoryView",
          "name": "Task History",
          "icon": "res/icon.svg",
          "when": "workspaceTasks.history.viewMode == 'tree'"
        },
        {
          "id": "workspaceTasksHistoryTableView",
          "name": "Task History",
          "type": "webview",
          "icon": "res/icon.svg",
          "when": "workspaceTasks.history.viewMode == 'table'"
        }
      ],
      "workspace-tasks": [
        {
          "id": "workspaceTasksView",
          "name": "Tasks",
          "icon": "res/icon.svg"
        }
      ],
      "explorer": [
        {
          "id": "workspaceTasksExplorer",
          "name": "Workspace Tasks",
          "icon": "res/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "workspaceTasks.refresh",
        "title": "%command.refreshTasks%",
        "icon": "$(refresh)"
      },
      {
        "command": "workspaceTasks.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "workspaceTasks.collapseAll",
        "title": "%command.collapseAll%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "workspaceTasks.buyMeACoffee",
        "title": "%command.buyMeACoffee%",
        "icon": {
          "light": "res/icons/light/coffee.svg",
          "dark": "res/icons/dark/coffee.svg"
        }
      },
      {
        "command": "workspaceTasks.githubSponsor",
        "title": "%command.githubSponsor%",
        "icon": {
          "light": "res/icons/light/github-sponsors.svg",
          "dark": "res/icons/dark/github-sponsors.svg"
        }
      },
      {
        "command": "workspaceTasks.githubIssues",
        "title": "%command.githubIssues%",
        "icon": "$(github-inverted)"
      },
      {
        "command": "workspaceTasks.onTreeItemClick",
        "title": "On Tree Item Click"
      },
      {
        "command": "workspaceTasks.openFileAtLine",
        "title": "%command.openFileAtLine%",
        "icon": "$(file-code)"
      },
      {
        "command": "workspaceTasks.runTask",
        "title": "%command.runTask%",
        "icon": "$(debug-start)"
      },
      {
        "command": "workspaceTasks.history.clear",
        "title": "%command.history.clear%",
        "icon": "$(clear-all)"
      },
      {
        "command": "workspaceTasks.history.switchTreeView",
        "title": "%command.history.switchTreeView%",
        "icon": "$(list-tree)"
      },
      {
        "command": "workspaceTasks.history.switchTableView",
        "title": "%command.history.switchTableView%",
        "icon": "$(list-flat)"
      },
      {
        "command": "workspaceTasks.history.enableFilterRunning",
        "title": "%command.history.enableFilterRunning%"
      },
      {
        "command": "workspaceTasks.history.disableFilterRunning",
        "title": "%command.history.disableFilterRunning%"
      },
      {
        "command": "workspaceTasks.history.enableFilterSuccess",
        "title": "%command.history.enableFilterSuccess%"
      },
      {
        "command": "workspaceTasks.history.disableFilterSuccess",
        "title": "%command.history.disableFilterSuccess%"
      },
      {
        "command": "workspaceTasks.history.enableFilterFailed",
        "title": "%command.history.enableFilterFailed%"
      },
      {
        "command": "workspaceTasks.history.disableFilterFailed",
        "title": "%command.history.disableFilterFailed%"
      },
      {
        "command": "workspaceTasks.history.enableFilterTerminated",
        "title": "%command.history.enableFilterTerminated%"
      },
      {
        "command": "workspaceTasks.history.disableFilterTerminated",
        "title": "%command.history.disableFilterTerminated%"
      },
      {
        "command": "workspaceTasks.runTaskWithArgs",
        "title": "%command.runTaskWithArgs%",
        "icon": "$(debug-continue)"
      },
      {
        "command": "workspaceTasks.stopTask",
        "title": "%command.stopTask%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "workspaceTasks.restartTask",
        "title": "%command.restartTask%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "workspaceTasks.removeFromRecentTasks",
        "title": "%command.removeFromRecentTasks%",
        "icon": "$(trash)"
      },
      {
        "command": "workspaceTasks.clearRecentTasks",
        "title": "%command.clearRecentTasks%",
        "icon": "$(clear-all)"
      },
      {
        "command": "workspaceTasks.addToFavorites",
        "title": "%command.addToFavorites%",
        "icon": {
          "light": "res/icons/light/star.svg",
          "dark": "res/icons/dark/star.svg"
        }
      },
      {
        "command": "workspaceTasks.removeFromFavorites",
        "title": "%command.removeFromFavorites%",
        "icon": {
          "light": "res/icons/light/star-full.svg",
          "dark": "res/icons/dark/star-full.svg"
        }
      },
      {
        "command": "workspaceTasks.addToQueue",
        "title": "%command.addToQueue%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "workspaceTasks.runQueue",
        "title": "%command.runQueue%",
        "icon": "$(run-all)"
      },
      {
        "command": "workspaceTasks.clearQueue",
        "title": "%command.clearQueue%",
        "icon": "$(clear-all)"
      },
      {
        "command": "workspaceTasks.removeFromQueue",
        "title": "%command.removeFromQueue%",
        "icon": "$(trash)"
      },
      {
        "command": "workspaceTasks.renameQueue",
        "title": "%command.renameQueue%",
        "icon": "$(edit)"
      },
      {
        "command": "workspaceTasks.hideTask",
        "title": "%command.hideTask%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "workspaceTasks.unhideTask",
        "title": "%command.unhideTask%",
        "icon": "$(eye)"
      },
      {
        "command": "workspaceTasks.hideGroup",
        "title": "%command.hideGroup%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "workspaceTasks.unhideGroup",
        "title": "%command.unhideGroup%",
        "icon": "$(eye)"
      },
      {
        "command": "workspaceTasks.showHiddenTasks",
        "title": "%command.showHiddenTasks%",
        "icon": "$(eye)"
      },
      {
        "command": "workspaceTasks.hideHiddenTasks",
        "title": "%command.hideHiddenTasks%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "workspaceTasks.resetFilteredTasks",
        "title": "%command.resetFilteredTasks%",
        "icon": {
          "light": "res/icons/light/clear-filter.svg",
          "dark": "res/icons/dark/clear-filter.svg"
        }
      },
      {
        "command": "workspaceTasks.context.addToQueue",
        "title": "%command.addToQueue%"
      },
      {
        "command": "workspaceTasks.context.addToFavorites",
        "title": "%command.addToFavorites%"
      },
      {
        "command": "workspaceTasks.copyTaskCommand",
        "title": "%command.copyTaskCommand%",
        "icon": "$(copy)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%view.name%",
      "properties": {
        "workspaceTasks.debug": {
          "type": "boolean",
          "default": false,
          "description": "%config.workspaceTasks.debug%"
        },
        "workspaceTasks.act.envFile": {
          "type": "string",
          "default": "",
          "description": "%workspaceTasks.act.envFile%",
          "markdownDescription": "%workspaceTasks.act.envFile.markdown%",
          "scope": "resource"
        },
        "workspaceTasks.act.variablesFile": {
          "type": "string",
          "default": "",
          "description": "Path to a file containing variables to pass to act (e.g. .vars).",
          "scope": "resource"
        },
        "workspaceTasks.act.variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "%workspaceTasks.act.variables%",
          "markdownDescription": "%workspaceTasks.act.variables.markdown%",
          "scope": "resource"
        },
        "workspaceTasks.act.secretsFile": {
          "type": "string",
          "default": ".secrets",
          "description": "%workspaceTasks.act.secretsFile%",
          "markdownDescription": "%workspaceTasks.act.secretsFile.markdown%",
          "scope": "resource"
        },
        "workspaceTasks.ant.ansicon.enabled": {
          "type": "boolean",
          "description": "%config.workspaceTasks.ant.ansicon.enabled%",
          "markdownDescription": "%config.workspaceTasks.ant.ansicon.enabled.markdown%",
          "default": true
        },
        "workspaceTasks.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.workspaceTasks.exclude.description%",
          "markdownDescription": "%config.workspaceTasks.exclude.markdown%"
        },
        "workspaceTasks.groups.enabled": {
          "title": "%config.workspaceTasks.groups.enabled%",
          "type": "boolean",
          "default": true,
          "description": "%config.workspaceTasks.groups.enabled.description%",
          "markdownDescription": "%config.workspaceTasks.groups.enabled.markdown%"
        },
        "workspaceTasks.groups.useParentFolder": {
          "title": "%config.workspaceTasks.groups.useParentFolder%",
          "type": "boolean",
          "default": false,
          "description": "%config.workspaceTasks.groups.useParentFolder.description%",
          "markdownDescription": "%config.workspaceTasks.groups.useParentFolder.markdown%"
        },
        "workspaceTasks.groups.recentTasks.enabled": {
          "title": "%config.workspaceTasks.groups.recentTasks.enabled%",
          "type": "boolean",
          "default": false,
          "description": "%config.workspaceTasks.groups.recentTasks.enabled%",
          "markdownDescription": "%config.workspaceTasks.groups.recentTasks.enabled.markdown%"
        },
        "workspaceTasks.recentTasks.maxItems": {
          "title": "%config.workspaceTasks.recentTasks.maxItems%",
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "%config.workspaceTasks.recentTasks.maxItems.description%",
          "markdownDescription": "%config.workspaceTasks.recentTasks.maxItems.markdown%"
        },
        "workspaceTasks.groups.taskSeparator": {
          "title": "%config.workspaceTasks.groups.taskSeparator%",
          "type": "string",
          "default": "",
          "description": "%config.workspaceTasks.groups.taskSeparator.description%",
          "markdownDescription": "%config.workspaceTasks.groups.taskSeparator.markdown%"
        },
        "workspaceTasks.taskDiscovery.fetchDepth": {
          "type": [
            "number",
            "null"
          ],
          "description": "%config.workspaceTasks.taskDiscovery.fetchDepth%",
          "markdownDescription": "%config.workspaceTasks.taskDiscovery.fetchDepth.markdown%",
          "default": null,
          "minimum": 1
        },
        "workspaceTasks.task.actionBar": {
          "type": "object",
          "markdownDescription": "%config.workspaceTasks.task.actionBar%",
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "boolean",
              "description": "%config.workspaceTasks.task.actionBar.run%"
            },
            "runWithArgs": {
              "type": "boolean",
              "description": "%config.workspaceTasks.task.actionBar.runWithArgs%"
            },
            "openFile": {
              "type": "boolean",
              "description": "%config.workspaceTasks.task.actionBar.openFile%"
            },
            "favorite": {
              "type": "boolean",
              "description": "%config.workspaceTasks.task.actionBar.favorite%"
            },
            "queue": {
              "type": "boolean",
              "description": "%config.workspaceTasks.task.actionBar.queue%"
            },
            "hide": {
              "type": "boolean",
              "description": "%command.hideTask%"
            },
            "unhide": {
              "type": "boolean",
              "description": "%command.unhideTask%"
            }
          },
          "default": {
            "run": true,
            "runWithArgs": true,
            "openFile": true,
            "favorite": true,
            "queue": true,
            "hide": false,
            "unhide": true
          }
        },
        "workspaceTasks.task.statusResetDelay": {
          "type": "number",
          "default": 500,
          "description": "%config.workspaceTasks.task.statusResetDelay%",
          "markdownDescription": "%config.workspaceTasks.task.statusResetDelay.markdown%"
        },
        "workspaceTasks.task.singleClickAction": {
          "type": "string",
          "enum": [
            "run",
            "runWithArgs",
            "open",
            "none"
          ],
          "enumDescriptions": [
            "Run the task",
            "Run the task with arguments",
            "Open the task",
            "Do nothing"
          ],
          "default": "open",
          "description": "%config.workspaceTasks.task.singleClickAction%",
          "markdownDescription": "%config.workspaceTasks.task.singleClickAction.markdown%"
        },
        "workspaceTasks.task.doubleClickAction": {
          "type": "string",
          "enum": [
            "run",
            "runWithArgs",
            "open",
            "none"
          ],
          "default": "run",
          "enumDescriptions": [
            "Run the task",
            "Run the task with arguments",
            "Open the task",
            "Do nothing"
          ],
          "description": "%config.workspaceTasks.task.doubleClickAction%",
          "markdownDescription": "%config.workspaceTasks.task.doubleClickAction.markdown%"
        },
        "workspaceTasks.task.presentationOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reveal": {
              "type": "string",
              "title": "%config.workspaceTasks.task.presentationOptions.reveal%",
              "description": "%config.workspaceTasks.task.presentationOptions.reveal.description%",
              "enum": [
                "always",
                "silent",
                "never"
              ],
              "default": "always"
            },
            "clear": {
              "title": "%config.workspaceTasks.task.presentationOptions.clear%",
              "description": "%config.workspaceTasks.task.presentationOptions.clear.description%",
              "type": "boolean",
              "default": false
            },
            "close": {
              "title": "%config.workspaceTasks.task.presentationOptions.close%",
              "description": "%config.workspaceTasks.task.presentationOptions.close.description%",
              "type": "boolean",
              "default": false
            },
            "echo": {
              "title": "%config.workspaceTasks.task.presentationOptions.echo%",
              "description": "%config.workspaceTasks.task.presentationOptions.echo.description%",
              "type": "boolean",
              "default": true
            },
            "focus": {
              "title": "%config.workspaceTasks.task.presentationOptions.focus%",
              "description": "%config.workspaceTasks.task.presentationOptions.focus.description%",
              "type": "boolean",
              "default": false
            },
            "panel": {
              "type": "string",
              "title": "%config.workspaceTasks.task.presentationOptions.panelKind%",
              "description": "%config.workspaceTasks.task.presentationOptions.panelKind.description%",
              "enum": [
                "dedicated",
                "shared",
                "new"
              ],
              "default": "shared"
            }
          }
        },
        "workspaceTasks.task.iconType": {
          "type": "string",
          "enum": [
            "type",
            "file",
            "gear",
            "run",
            "custom"
          ],
          "default": "type",
          "description": "%config.workspaceTasks.task.iconType%",
          "enumDescriptions": [
            "The task type icon used to represent the type of the task",
            "The vscode defined file icon for the task source file",
            "A gear icon that usually represents settings or configuration",
            "A play icon that usually represents running or starting something",
            "A custom icon defined by the user"
          ],
          "markdownDescription": "%config.workspaceTasks.task.iconType.markdown%"
        },
        "workspaceTasks.task.iconTypeCustom": {
          "type": "string",
          "default": "",
          "description": "%config.workspaceTasks.task.iconTypeCustom%",
          "markdownDescription": "%config.workspaceTasks.task.iconTypeCustom.markdown%"
        },
        "workspaceTasks.shellEnabledTaskTypes": {
          "type": "object",
          "additionalProperties": false,
          "description": "%config.workspaceTasks.shellEnabledTaskTypes%",
          "markdownDescription": "%config.workspaceTasks.shellEnabledTaskTypes.markdown%",
          "properties": {
            "bash": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.bash%"
            },
            "batch": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.batch%"
            },
            "fish": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.fish%"
            },
            "nushell": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.nushell%"
            },
            "perl": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.perl%"
            },
            "pwsh": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.pwsh%"
            },
            "python": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.python%"
            },
            "ruby": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.ruby%"
            },
            "sh": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.sh%"
            },
            "zsh": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.zsh%"
            },
            "other": {
              "type": "boolean",
              "description": "%config.workspaceTasks.shellEnabledTaskTypes.other%"
            }
          },
          "default": {
            "bash": true,
            "batch": true,
            "sh": true,
            "zsh": true,
            "fish": true,
            "nushell": true,
            "perl": true,
            "pwsh": true,
            "python": true,
            "ruby": true,
