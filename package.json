          "group": "1_status",
          "when": "workspaceTasks.history.showTerminated"
        }
      ],
      "view/item/context": [
        {
          "command": "workspaceTasks.runQueue",
          "when": "viewItem == queue",
          "group": "inline@1"
        },
        {
          "command": "workspaceTasks.renameQueue",
          "when": "viewItem == queue",
          "group": "inline@2"
        },
        {
          "command": "workspaceTasks.clearQueue",
          "when": "viewItem == queue",
          "group": "inline@3"
        },
        {
          "command": "workspaceTasks.runTask",
          "when": "(viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask) && config.workspaceTasks.task.actionBar.run",
          "group": "inline@3"
        },
        {
          "command": "workspaceTasks.runTaskWithArgs",
          "when": "(viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask) && config.workspaceTasks.task.actionBar.runWithArgs",
          "group": "inline@3"
        },
        {
          "command": "workspaceTasks.openFileAtLine",
          "when": "(viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask) && config.workspaceTasks.task.actionBar.openFile",
          "group": "inline@3"
        },
        {
          "command": "workspaceTasks.runTask",
          "when": "viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask",
          "group": "1_run@1"
        },
        {
          "command": "workspaceTasks.runTaskWithArgs",
          "when": "viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask",
          "group": "1_run@2"
        },
        {
          "command": "workspaceTasks.openFileAtLine",
          "when": "viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask",
          "group": "2_open"
        },
        {
          "command": "workspaceTasks.addToFavorites",
          "when": "viewItem == task || viewItem == queuedTask || viewItem == recentTask || viewItem == filteredTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask",
          "group": "3_favorites"
        },
        {
          "command": "workspaceTasks.removeFromFavorites",
          "when": "viewItem == favoriteTask || viewItem == favoriteRecentTask || viewItem == filteredFavoriteTask || viewItem == filteredFavoriteRecentTask",
          "group": "3_favorites"
        },
        {
          "command": "workspaceTasks.addToQueue",
          "when": "viewItem == task || viewItem == favoriteTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask",
          "group": "4_queue"
        },
        {
          "command": "workspaceTasks.removeFromQueue",
          "when": "viewItem == queuedTask || viewItem == filteredQueuedTask",
          "group": "4_queue"
        },
        {
          "command": "workspaceTasks.copyTaskCommand",
          "when": "viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask",
          "group": "5_copy"
        },
        {
          "command": "workspaceTasks.restartTask",
          "when": "viewItem == runningTask",
          "group": "inline@1"
        },
        {
          "command": "workspaceTasks.stopTask",
          "when": "viewItem == runningTask",
          "group": "inline@2"
        },
        {
          "command": "workspaceTasks.addToFavorites",
          "when": "(viewItem == task || viewItem == queuedTask || viewItem == recentTask || viewItem == filteredTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask) && config.workspaceTasks.task.actionBar.favorite",
          "group": "inline@1"
        },
        {
          "command": "workspaceTasks.removeFromFavorites",
          "when": "(viewItem == favoriteTask || viewItem == favoriteRecentTask || viewItem == filteredFavoriteTask || viewItem == filteredFavoriteRecentTask) && config.workspaceTasks.task.actionBar.favorite",
          "group": "inline@1"
        },
        {
          "command": "workspaceTasks.addToQueue",
          "when": "(viewItem == task || viewItem == favoriteTask || viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask) && config.workspaceTasks.task.actionBar.queue",
          "group": "inline@2"
        },
        {
          "command": "workspaceTasks.removeFromQueue",
          "when": "(viewItem == queuedTask || viewItem == filteredQueuedTask) && config.workspaceTasks.task.actionBar.queue",
          "group": "inline@2"
        },
        {
          "command": "workspaceTasks.removeFromRecentTasks",
          "when": "viewItem == recentTask || viewItem == favoriteRecentTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask",
          "group": "inline@0"
        },
        {
          "command": "workspaceTasks.hideTask",
          "when": "(viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask) && !workspaceTasks.taskIsFiltered && config.workspaceTasks.task.actionBar.hide",
          "group": "inline@0"
        },
        {
          "command": "workspaceTasks.unhideTask",
          "when": "(viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask) && workspaceTasks.showHiddenMode && config.workspaceTasks.task.actionBar.unhide",
          "group": "inline@0"
        },
        {
          "command": "workspaceTasks.unhideGroup",
          "when": "(viewItem == filteredWorkspace || viewItem == filteredType || viewItem == filteredFolder) && workspaceTasks.showHiddenMode && config.workspaceTasks.task.actionBar.unhide",
          "group": "inline@0"
        },
        {
          "command": "workspaceTasks.clearRecentTasks",
          "when": "viewItem == recent",
          "group": "inline@1"
        },
        {
          "command": "workspaceTasks.hideTask",
          "when": "(viewItem == task || viewItem == favoriteTask || viewItem == queuedTask || viewItem == recentTask || viewItem == favoriteRecentTask) && !workspaceTasks.taskIsFiltered",
          "group": "taskFiltering@1"
        },
        {
          "command": "workspaceTasks.unhideTask",
          "when": "(viewItem == filteredTask || viewItem == filteredFavoriteTask || viewItem == filteredQueuedTask || viewItem == filteredRecentTask || viewItem == filteredFavoriteRecentTask) && workspaceTasks.showHiddenMode",
          "group": "taskFiltering@1"
        },
        {
          "command": "workspaceTasks.hideGroup",
          "when": "(viewItem == workspace || viewItem == type || viewItem == folder) && !workspaceTasks.taskIsFiltered",
          "group": "taskFiltering@2"
        },
        {
          "command": "workspaceTasks.unhideGroup",
          "when": "(viewItem == filteredWorkspace || viewItem == filteredType || viewItem == filteredFolder) && workspaceTasks.showHiddenMode",
          "group": "taskFiltering@2"
        }
      ]
    }
