{
  "$schema": "../schemas/workspace-tasks.schema.json",
  "go": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/go.mod"]
    },
    "iconUri": "go.mod",
    "inputs": [
      {
        "id": "PackageName",
        "type": "promptString",
        "description": "Enter the package name to build/test",
        "default": "./..."
      }
    ],
    "tasks": [
      {
        "label": "go:build",
        "type": "shell",
        "command": "go build ./...",
        "group": "go",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "go:build:package",
        "type": "shell",
        "command": "go build {{ .PackageName }}",
        "group": "go",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "go:clean",
        "type": "shell",
        "command": "go clean ./...",
        "group": "go",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "go:clean:package",
        "type": "shell",
        "command": "go clean {{ .PackageName }}",
        "group": "go",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "go:fmt",
        "type": "shell",
        "command": "go fmt ./...",
        "group": "go",
        "hide": true,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "go:list",
        "type": "shell",
        "command": "go list./...",
        "group": "go",
        "hide": true,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "go:test",
        "type": "shell",
        "command": "go test ./...",
        "group": "go",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "go:test:package",
        "type": "shell",
        "command": "go test {{ .PackageName }}",
        "group": "go",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      }
    ]
  },
  "pipenv": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/[pP]ip[fF]ile"]
    },
    "iconUri": "Pipfile",
    "tasks": [
      {
        "label": "pipenv:install",
        "type": "shell",
        "command": "pipenv install",
        "group": "pipenv",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "pipenv:check",
        "type": "shell",
        "command": "pipenv check",
        "group": "pipenv",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "pipenv:lock",
        "type": "shell",
        "command": "pipenv lock",
        "group": "pipenv",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      }
    ]
  },
  "docker-compose": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/docker-compose.yml"]
    },
    "iconUri": "docker-compose.yml",
    "tasks": [
      {
        "label": "docker-compose:up",
        "type": "shell",
        "command": "docker-compose up -d",
        "group": "docker-compose",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "docker-compose:down",
        "type": "shell",
        "command": "docker-compose down",
        "group": "docker-compose",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      }
    ]
  },
  "dockerfile": {
    "version": "2.0.0",
    "globs": {
      "include": ["{**/Dockerfile,**/dockerfile,**/*.dockerfile,**/Dockerfile.*}"]
    },
    "iconUri": "dockerfile",
    "inputs": [
      {
        "id": "Name",
        "type": "promptString",
        "description": "Enter the name for the Docker image",
        "default": "${workspaceFolderBasename}"
      },
      {
        "id": "Tag",
        "type": "promptString",
        "description": "Enter the tag for the Docker image",
        "default": "latest"
      }
    ],
    "tasks": [
      {
        "label": "dockerfile:build",
        "type": "shell",
        "command": "docker build -t {{ .Name }}:{{ .Tag }} .",
        "group": "dockerfile",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      }
    ]
  },
  "typescript": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/tsconfig.json"]
    },
    "iconUri": "tsconfig.json",
    "tasks": [
      {
        "label": "compile",
        "type": "shell",
        "command": "npx tsc -p {{ .FileName }}",
        "group": "typescript",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      },
      {
        "label": "watch",
        "type": "shell",
        "command": "npx tsc -p {{ .FileName }} --watch",
        "group": "typescript",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
        }
      }
    ]
  },
  "bun": {
    "version": "2.0.0",
    "globs": {
      "include": [
        "**/package.json"
      ]
    },
    "tasks": [
      {
        "label": "bun:install",
        "type": "bun",
        "command": "bun install",
        "group": "bun",
