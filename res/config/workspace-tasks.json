    "version": "2.0.0",
    "globs": {
      "include": ["**/.venv/pyvenv.cfg"]
    },
    "iconUri": "venv.py",
    "tasks": [
      {
        "label": "venv:create",
        "type": "shell",
        "command": "echo \"python -m venv .venv ${workspaceFolder}\"",
        "group": "venv",
        "hide": false,
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared",
          "reveal": "always",
          "clear": false
