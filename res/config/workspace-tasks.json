{
  "$schema": "../schemas/workspace-tasks.schema.json",
  "pipenv": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/[pP]ip[fF]ile"]
    },
    "iconUri": "Pipfile",
    "tasks": [
      {
        "label": "~ Install Dependencies",
        "type": "shell",
        "command": "pipenv install",
        "group": "build"
      },
      {
        "label": "~ Check Dependencies",
        "type": "shell",
        "command": "pipenv check",
        "group": "build"
      },
      {
        "label": "~ Generate Pipfile.lock",
        "type": "shell",
        "command": "pipenv lock",
        "group": "build"
      }
    ]
  },
  "docker-compose": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/docker-compose.yml"]
    },
    "iconUri": "docker-compose.yml",
    "tasks": [
      {
        "label": "~ Start Services",
        "type": "shell",
        "command": "docker-compose up -d",
        "group": "build"
      },
      {
        "label": "~ Stop Services",
        "type": "shell",
        "command": "docker-compose down",
        "group": "build"
      }
    ]
  },
  "dockerfile": {
    "version": "2.0.0",
    "globs": {
      "include": ["{**/Dockerfile,**/dockerfile,**/*.dockerfile,**/Dockerfile.*}"]
    },
    "iconUri": "dockerfile",
    "inputs": [
      {
        "id": "Name",
        "type": "promptString",
        "description": "Enter the name for the Docker image",
        "default": "${workspaceFolderBasename}"
      },
      {
        "id": "Tag",
        "type": "promptString",
        "description": "Enter the tag for the Docker image",
        "default": "latest"
      }
    ],
    "tasks": [
      {
        "label": "~ Build Docker Image",
        "type": "shell",
        "command": "docker build -t {{ .Name }}:{{ .Tag }} .",
        "group": "build"
      }
    ]
  },
  "typescript": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/tsconfig.json"]
    },
    "iconUri": "tsconfig.json",
    "tasks": [
      {
        "label": "~ Compile",
        "type": "shell",
        "command": "npx tsc -p {{ .FileName }}",
        "group": "build"
      },
      {
        "label": "~ Watch",
        "type": "shell",
        "command": "npx tsc -p {{ .FileName }} --watch",
        "group": "build"
      }
    ]
  },
  "npm": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/package.json"]
    },
    "inputs": [
      {
        "id": "Package",
        "type": "promptString",
        "description": "Enter the package name to update",
        "placeholder": "Leave empty to update all packages",
        "default": ""
      }
    ],
    "tasks": [
      {
        "label": "~ NPM Install",
        "type": "shell",
        "command": "npm install",
        "group": "build"
      },
      {
        "label": "~ NPM Audit",
        "type": "shell",
        "command": "npm audit",
        "group": "build"
      },
      {
        "label": "~ NPM Audit Fix",
        "type": "shell",
        "command": "npm audit fix",
        "group": "build"
      },
      {
        "label": "~ NPM Update [package]",
        "type": "shell",
        "command": "npm update {{ .Package }}",
        "group": "build"
      }
    ]
  },
  "pnpm": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/package.json"]
    },
    "inputs": [
      {
        "id": "Package",
        "type": "promptString",
        "description": "Enter the package name to update",
        "placeholder": "Leave empty to update all packages",
        "default": ""
      }
    ],
    "tasks": [
      {
        "label": "~ PNPM Install",
        "type": "shell",
        "command": "pnpm install",
        "group": "build"
      },
      {
        "label": "~ PNPM Update [package]",
        "type": "shell",
        "command": "pnpm update {{ .Package }}",
        "group": "build"
      }
    ]
  },
  "yarn": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/package.json"]
    },
    "inputs": [
      {
        "id": "Package",
        "type": "promptString",
        "description": "Enter the package name to update",
        "placeholder": "Leave empty to update all packages",
        "default": ""
      }
    ],
    "tasks": [
      {
        "label": "~ Yarn Install",
        "type": "shell",
        "command": "yarn install",
        "group": "build"
      },
      {
        "label": "~ Yarn Update [package]",
        "type": "shell",
        "command": "yarn upgrade {{ .Package }}",
        "group": "build"
      }
    ]
  },
  "venv": {
    "version": "2.0.0",
    "globs": {
      "include": ["**/.venv/pyvenv.cfg"]
    },
    "iconUri": "venv.py",
    "tasks": [
      {
        "label": "~ Create Virtual Environment",
        "type": "shell",
        "command": "echo \"python -m venv .venv ${workspaceFolder}\"",
        "group": "build"
      }
    ]
  },
  "eslint": {
    "version": "2.0.0",
    "globs": {
      "include": [
        "**/eslint.config.{js,mjs,cjs,ts,mts,cts}"
      ]
    },
    "iconUri": "eslint.config.mjs",
    "inputs": [
      {
        "id": "eslint_cache_location",
        "description": "Path to the cache file or directory",
        "default": ".eslintcache",
        "type": "promptString"
      }
    ],
    "tasks": [
      {
        "label": "run",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "run:cache",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --cache",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "run:verbose",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --verbose",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "fix",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --fix",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "fix:cache",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --fix --cache",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "fix:quiet",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --fix --quiet",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "fix:verbose",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --fix --verbose",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "fix:dryrun",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --fix --dry-run",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "fix:dryrun:verbose",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --fix --dry-run --verbose",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "analyze:config",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --fix --inspect-config",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "analyze:problems",
        "type": "shell",
        "command": "npx eslint {{ .FileName }} --color --fix --debug",
        "group": "eslint",
        "presentation": {
          "echo": false,
          "focus": false,
          "panel": "shared"
        }
      }
    ]

  }
}
