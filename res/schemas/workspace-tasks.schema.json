{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "File Tasks Configuration",
  "description": "Schema for defining file-based tasks in a workspace",
  "$id": "http://json-schema.org/draft-07/schema#workspace-tasks",
  "type": "object",
  "patternProperties": {
    "^[a-z0-9\\-]+$": {
      "type": "object",
      "description": "Configuration for a specific language ID",
      "properties": {
        "version": {
          "type": "string",
          "description": "The task configuration version."
        },
        "globs": {
          "type": "object",
          "description": "Glob patterns for file discovery",
          "properties": {
            "include": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Patterns to include"
            },
            "exclude": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Patterns to exclude"
            }
          },
          "required": ["include"]
        },
        "inputs": {
          "type": "array",
          "description": "Inputs to be used in task commands",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["promptString", "pickString"] },
              "description": { "type": "string" },
              "default": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "type", "description"]
          }
        },
        "iconUri": {
          "anyOf": [
            { "type": "string", "pattern": "^\\$\\([a-zA-Z0-9_-]+\\)$", "description": "A codicon reference (e.g. $(python))" },
            { "type": "string", "description": "A path or URI to an icon image" },
            {
              "type": "object",
              "description": "Separate icon paths for light and dark themes",
              "properties": {
                "light": { "type": "string", "description": "Path or URI to the icon for light theme" },
                "dark": { "type": "string", "description": "Path or URI to the icon for dark theme" }
              },
              "required": ["light", "dark"]
            }
          ]
        },
        "taskType": {
          "type": "string",
          "description": "The enabled task type setting key that controls whether this provider is shown in the tree. If omitted, the top-level key name is used. Use this to map provider keys like 'dockerfile' or 'docker-compose' to a shared setting such as 'docker'."
        },
        "envFiles": {
          "description": "One or more .env files to load for all tasks in this language block. Supports a single path/glob string, an ordered array of paths/globs, or an include/exclude object.",
          "oneOf": [
            { "type": "string", "description": "A single file path or glob pattern." },
            { "type": "array", "items": { "type": "string" }, "description": "An ordered list of file paths or glob patterns." },
            {
              "type": "object",
              "description": "Include/exclude glob object.",
              "properties": {
                "include": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to include." },
                "exclude": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to exclude." }
              },
              "required": ["include"],
              "additionalProperties": false
            }
          ]
        },
        "env": {
          "type": "object",
          "description": "Environment variables to set for all tasks in this language block.",
          "additionalProperties": { "type": "string" }
        },
        "secretFiles": {
          "description": "One or more .secret files to load for all tasks in this language block. Values from these files never trigger secret-pattern warnings. Accepts the same forms as envFiles.",
          "oneOf": [
            { "type": "string", "description": "A single file path or glob pattern." },
            { "type": "array", "items": { "type": "string" }, "description": "An ordered list of file paths or glob patterns." },
            {
              "type": "object",
              "description": "Include/exclude glob object.",
              "properties": {
                "include": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to include." },
                "exclude": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to exclude." }
              },
              "required": ["include"],
              "additionalProperties": false
            }
          ]
        },
        "tasks": {
          "type": "array",
          "description": "List of tasks to be generated for files matching the language ID",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "This is the task type. (e.g. npm, shell, grunt, etc.)"
              },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "options": {
                "type": "object",
                "properties": {
                  "cwd": { "type": "string" },
                  "env": { "type": "object" }
                }
              },
              "group": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string" },
                      "isDefault": { "type": "boolean" }
                    }
                  }
                ]
              },
              "presentation": {
                "type": "object",
                "properties": {
                  "echo": { "type": "boolean" },
                  "reveal": { "type": "string", "enum": ["always", "silent", "never"] },
                  "focus": { "type": "boolean" },
                  "panel": { "type": "string", "enum": ["shared", "dedicated", "new"] },
                  "showReuseMessage": { "type": "boolean" },
                  "clear": { "type": "boolean" }
                }
              },
              "problemMatcher": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "object" }
                ]
              },
              "hide": {
                "type": "boolean",
                "description": "If true, the task will be hidden from the task list by default."
              },
              "envFiles": {
                "description": "One or more .env files to load for this task. Supports a single path/glob string, an ordered array of paths/globs, or an include/exclude object.",
                "oneOf": [
                  { "type": "string", "description": "A single file path or glob pattern." },
                  { "type": "array", "items": { "type": "string" }, "description": "An ordered list of file paths or glob patterns." },
                  {
                    "type": "object",
                    "description": "Include/exclude glob object.",
                    "properties": {
                      "include": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to include." },
                      "exclude": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to exclude." }
                    },
                    "required": ["include"],
                    "additionalProperties": false
                  }
                ]
              },
              "env": {
                "type": "object",
                "description": "Environment variables to set for this task.",
                "additionalProperties": { "type": "string" }
              },
              "secretFiles": {
                "description": "One or more .secret files to load for this task. Values from these files never trigger secret-pattern warnings. Accepts the same forms as envFiles.",
                "oneOf": [
                  { "type": "string", "description": "A single file path or glob pattern." },
                  { "type": "array", "items": { "type": "string" }, "description": "An ordered list of file paths or glob patterns." },
                  {
                    "type": "object",
                    "description": "Include/exclude glob object.",
                    "properties": {
                      "include": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to include." },
                      "exclude": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to exclude." }
                    },
                    "required": ["include"],
                    "additionalProperties": false
                  }
                ]
              },
              "secrets": {
                "type": "object",
                "description": "Maps environment variable names to VS Code SecretStorage keys. Values are fetched from SecretStorage at run time and never trigger secret-pattern warnings.",
                "additionalProperties": { "type": "string" }
              }
            },
            "required": ["label", "command", "type"]
          }
        }
      },
      "required": ["tasks"]
    }
  }
}
