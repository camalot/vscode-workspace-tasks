{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cancelable",
      "command": "docker run --rm -it alpine:latest /bin/sh -c 'echo Sleeping...;sleep infinity & wait $!'",
      "type": "shell",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false,
        "close": false
      }
    }
  ]
}
