[[source]]
url = "https://pypi.python.org/simple"
verify_ssl = true
name = "pypi"

[packages]
requests = "*"
Flask = "*"

[dev-packages]
pytest = "*"
flake8 = "*"

[scripts]
start = "python app.py"
test = "pytest tests/"
lint = "flake8 ."
clean = "rm -rf build/ dist/ *.egg-info"
build = "python setup.py build"
all = "pipenv run clean && pipenv run build && pipenv run test"

[pipenv]
allow_prereleases = true
