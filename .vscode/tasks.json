{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "webpack .*? watch",
          "endsPattern": "webpack .*? compiled successfully"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: watch"
    },
    {
      "type": "shell",
      "command": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync(p.join('res','webviews','lib'),{recursive:true});fs.copyFileSync(p.join('node_modules','chart.js','dist','chart.umd.min.js'),p.join('res','webviews','lib','chart.umd.min.js'));console.log('bundled chart.js');\" && node_modules/.bin/webpack",
      "problemMatcher": "$ts-webpack",
      "group": "build",
      "label": "npm: compile"
    },
    {
      "type": "npm",
      "script": "test",
      "group": "test",
      "label": "npm: test",
      "presentation": {
        "reveal": "always",
      }
    },
        {
          "label": "Dependee 1",
          "command": "echo hello"
        },
        {
          "label": "Dependee 2",
          "type": "shell",
          "command": "echo hello"
        },
        {
          "label": "My Task",
          "type": "shell",
          "command": "echo hello",
          "dependsOn": [
            "Dependee 1",
            "Dependee 2"
          ]
        },
        {
          "label": "My Group - My Task",
          "type": "shell",
          "command": "echo hello",
          "dependsOn": [
            "Dependee 1",
            "Dependee 2"
          ]
        },
  ]
}
